.cache-loader

# Misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Yarn Berry: ignore local cache/state but keep committed patches,
# since yarn.lock resolves @docusaurus/theme-common via a relative
# path into .yarn/patches/ - without it, `yarn install --immutable`
# fails in CI with ENOENT.
.yarn/*
!.yarn/patches
SUPABASE_SETUP.md
_bmad/*
.claude/
_bmad-output/
.bmad-core/
web-bundles/

# Supabase CLI local state — which project the repo is linked to and the
# hosted service versions. Regenerated by the CLI, specific to one machine,
# and holds the project ref and pooler URL.
supabase/.temp/
